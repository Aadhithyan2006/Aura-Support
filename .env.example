# ── Aura Support — Environment Variables ──────────────────────────────────────
#
# Copy this file to .env and fill in your values for local development.
# On Render, set these in: Dashboard → Your Service → Environment
#
# ──────────────────────────────────────────────────────────────────────────────

# REQUIRED — Google Gemini API key
# Get one free at: https://aistudio.google.com/app/apikey
# Without this key the app still works using the local KB fallback.
GEMINI_API_KEY="your_gemini_api_key_here"

# OPTIONAL — Set automatically by Render at runtime
# NODE_ENV="production"
# PORT="10000"
